  # declare_args() references ${target_platform}, which is only declared
  # in standard system builds (undefined identifier under lite gn).
  _dhfwk_lite_path = "//foundation/distributedhardware/distributed_hardware_fwk/lite"

  # Shim dir first: lite consumers of the shared interface headers resolve
  # <refbase.h>/<iremote_broker.h>/<ffrt.h> to the compat stubs via
  # public_configs propagation (design DD-1, contracts C7).
  config("utils_external_config") {
    include_dirs = [
      "${_dhfwk_lite_path}/common/utils/include",
      "${_dhfwk_lite_path}/utils/include",
    ]
  }

  shared_library("distributedhardwareutils") {
    public_configs = [ ":utils_external_config" ]

    include_dirs = [
      "//base/hiviewdfx/hilog_lite/interfaces/native/innerkits",
      "//foundation/communication/dsoftbus/interfaces/kits/bus_center",
      "//foundation/communication/dsoftbus/interfaces/kits/common",
      "//foundation/distributedhardware/device_manager/lite/interfaces/include",
      "//third_party/bounds_checking_function/include",
      "//third_party/zlib",
      "${_dhfwk_lite_path}/common/log/include",
    ]

    sources = [
      "anonymous_string.cpp",
      "device_param_mgr.cpp",
      "dh_utils_hisysevent.cpp",
      "dh_utils_hitrace.cpp",
      "dh_utils_tool.cpp",
      "node_key_provider.cpp",
      "sha256.cpp",
    ]

    deps = [
      "//base/hiviewdfx/hilog_lite/frameworks/featured:hilog_shared",
      "//base/startup/init/interfaces/innerkits:libbegetutil",
      "//build/lite/config/component/cJSON:cjson_shared",
      "//build/lite/config/component/zlib:zlib_shared",
      # TASK-13 (D-DM1 ruling 2): uuid/udid supply via softbus GetNodeKeyInfo.
      # Same dep form as device_manager lite (dm_lite_external_deps group).
      "//foundation/communication/dsoftbus/sdk:softbus_client",
      "//foundation/distributedhardware/device_manager/lite/interfaces:devicemanagersdk",
      "//third_party/bounds_checking_function:libsec_shared",
    ]

    defines = [
      "HI_LOG_ENABLE",
      "DH_LOG_TAG=\"dhfwkutils\"",
      "LOG_DOMAIN=0xD004100",
    ]

    # language_cpp pins -std=c++11; the shared headers (device_type.h
    # inline variables) require C++17. The clang++ driver links the C++
    # runtime automatically, no manual -lstdc++ needed.
    configs -= [ "//build/lite/config:language_cpp" ]
    cflags_cc = [
      "-fPIC",
      "-std=c++17",
    ]
    ldflags = [ "-fPIC" ]
  }
