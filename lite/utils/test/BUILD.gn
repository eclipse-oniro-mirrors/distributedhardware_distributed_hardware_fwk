  import("//build/lite/config/component/lite_component.gni")

  # lite: FIPS 180-4 SHA-256 unit test (host-runnable, zero deps).
  # Same sources also compile standalone on host:
  #   g++ -std=c++17 utils/sha256.cpp utils/test/sha256_test.cpp
  executable("sha256_test") {
    testonly = true

    sources = [
      "../sha256.cpp",
      "sha256_test.cpp",
    ]

    include_dirs = [ "../include" ]

    configs -= [ "//build/lite/config:language_cpp" ]
    cflags_cc = [ "-std=c++17" ]
  }

  # lite: softbus node-key provider unit test (TASK-13). Host-runnable via
  # link-time stub injection of GetNodeKeyInfo (no softbus dep needed):
  #   g++ -std=c++17 -I utils -I common/utils/include \
  #       -I <dsoftbus>/interfaces/kits/bus_center -I <dsoftbus>/interfaces/kits/common \
  #       utils/node_key_provider.cpp utils/test/node_key_provider_test.cpp
  executable("node_key_provider_test") {
    testonly = true

    sources = [
      "../node_key_provider.cpp",
      "node_key_provider_test.cpp",
    ]

    include_dirs = [
      "../include",
      "../../common/utils/include",
      "//foundation/communication/dsoftbus/interfaces/kits/bus_center",
      "//foundation/communication/dsoftbus/interfaces/kits/common",
    ]

    configs -= [ "//build/lite/config:language_cpp" ]
    cflags_cc = [ "-std=c++17" ]
  }

  group("utils_test") {
    testonly = true
    deps = [
      ":node_key_provider_test",
      ":sha256_test",
    ]
  }
